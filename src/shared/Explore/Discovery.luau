--!strict
-- Discovery: the exploration logbook rules (docs 10 section 5.2, docs 03 section 8.1). Pure data
-- and maths, safe in Lune (tests/Explore.spec.luau).
--
-- Entries come from WorldConfig.POIs (generated by tools/world/gen_terrain.py, so the reward and
-- reach fields live here, keyed by POI id, not in the generated file) plus EXTRA (logbook entries
-- without a built seabed object, such as the Harbour Light history).
--
-- Reach: an entry is logged when the server sees the player inside its area (ExplorationService,
-- 1 Hz). Seabed entries (wrecks, finds, gullies) need the player in the sea, not aboard a vessel,
-- within an oriented box around the object and no more than MAX_GAP studs above it: a snorkeller
-- face down at the surface sees about 10 m down in Calm Bay, a duck dive (5 m) reaches the rest.
-- Viewpoints and rock pools need the player on foot; a lighthouse history counts from foot or boat.
--
-- Rewards (docs 03 section 8.1, one time, no Reputation): a discovery 100 Cash, a wreck 250, a
-- lighthouse history 150; a completed logbook page 1,000 to 2,500 Cash and a cosmetic. Pages
-- complete at their launch count (Target), so in the MVP no page can complete yet.
--
-- Saving: the found set is stored as profile flags `logbook1..n` (ProgressionService.SetFlag),
-- CHUNK ids per flag (a flag table holds at most 24 fields).
local WorldConfig = require(script.Parent.Parent.Config.WorldConfig)

export type Mode = "water" | "foot" | "any"

export type Entry = {
	id: string,
	kind: string,
	page: string,
	name: string,
	era: string,
	blurb: string,
	position: Vector3,
	yaw: number, -- degrees
	length: number, -- along the yaw axis (studs)
	beam: number,
	pad: number, -- reach margin around the box (studs)
	maxGap: number, -- how far above (or below) the entry the player may be (studs)
	mode: Mode,
	reward: number, -- Cash
	terrainAxis: boolean, -- yaw convention of tools/world (length along (cos, sin) in x, z)
}

export type Page = {
	id: string,
	title: string,
	target: number, -- entries at launch [L]; the page completes at this count
	reward: number,
	cosmetic: string?,
}

export type Context = { seated: boolean, inWater: boolean }

local Discovery = {}

Discovery.FLAG_PREFIX = "logbook"
Discovery.CHUNK = 24
Discovery.DUTY_FLAG = "offDuty"
Discovery.STUDS_PER_M = 3

-- Logbook pages, in display order (docs 10 section 5.2 counts at [L]).
Discovery.Pages = {
	{
		id = "Wrecks",
		title = "Wrecks",
		target = 7,
		reward = 2500,
		cosmetic = "Wreck-hunter mask pattern",
	},
	{ id = "Seabed", title = "Rock pools and seabed", target = 10, reward = 1500 },
	{ id = "Places", title = "Places", target = 20, reward = 2000, cosmetic = "Explorer's jacket" },
	{ id = "Viewpoints", title = "Viewpoints", target = 8, reward = 1000 },
	{
		id = "Lighthouses",
		title = "Lighthouse histories",
		target = 4,
		reward = 1500,
		cosmetic = "Lighthouse model for the trophy wall",
	},
	{ id = "Coves", title = "Hidden coves and caves", target = 6, reward = 1500 },
	{
		id = "Wildlife",
		title = "Wildlife",
		target = 14,
		reward = 2000,
		cosmetic = "Seal plush for the bay",
	},
} :: { Page }

-- Per POI kind: page, reward, reach rule (tune).
local KINDS: { [string]: { page: string, reward: number, mode: Mode, pad: number, gap: number, radius: number } } =
	{
		Wreck = { page = "Wrecks", reward = 250, mode = "water", pad = 24, gap = 36, radius = 0 },
		Find = { page = "Seabed", reward = 100, mode = "water", pad = 20, gap = 30, radius = 0 },
		Seabed = { page = "Seabed", reward = 100, mode = "water", pad = 20, gap = 32, radius = 0 },
		RockPool = { page = "Seabed", reward = 100, mode = "foot", pad = 0, gap = 12, radius = 36 },
		Viewpoint = {
			page = "Viewpoints",
			reward = 100,
			mode = "foot",
			pad = 0,
			gap = 15,
			radius = 30,
		},
		Lighthouse = {
			page = "Lighthouses",
			reward = 150,
			mode = "any",
			pad = 0,
			gap = 40,
			radius = 45,
		},
		Place = { page = "Places", reward = 100, mode = "foot", pad = 0, gap = 15, radius = 30 },
		Cove = { page = "Coves", reward = 100, mode = "any", pad = 0, gap = 20, radius = 40 },
	}

-- Entries that are not seabed objects in WorldConfig.POIs.
Discovery.EXTRA = {
	{
		id = "HarbourLightHistory",
		kind = "Lighthouse",
		name = "Harbour Light",
		era = "1868",
		blurb = "The red and white light on the east breakwater head, kept by Tobias's family for three generations.",
		position = Vector3.new(44, 6, 320), -- map/Build.luau buildLighthouse, east wall head
	},
}

local function build(): { Entry }
	local list: { Entry } = {}
	local sources: { any } = {}
	for _, p in WorldConfig.POIs do
		table.insert(sources, p)
	end
	for _, p in Discovery.EXTRA do
		table.insert(sources, p)
	end
	for _, p in sources do
		local k = KINDS[p.kind] or KINDS.Place
		local length, beam = p.length or 0, p.beam or 0
		if k.radius > 0 then
			length, beam = k.radius * 2, k.radius * 2
		end
		table.insert(list, {
			id = p.id,
			kind = p.kind,
			page = k.page,
			name = p.name,
			era = p.era or "",
			blurb = p.blurb or "",
			position = p.position,
			yaw = p.yaw or 0,
			length = length,
			beam = beam,
			pad = k.pad,
			maxGap = k.gap,
			mode = k.mode,
			reward = k.reward,
			terrainAxis = p.kind == "Seabed",
		})
	end
	return list
end

Discovery.Entries = build()

local byId: { [string]: Entry } = {}
for _, e in Discovery.Entries do
	byId[e.id] = e
end

function Discovery.get(id: string): Entry?
	return byId[id]
end

function Discovery.page(id: string): Page?
	for _, p in Discovery.Pages do
		if p.id == id then
			return p
		end
	end
	return nil
end

-- True when a player at `pos` (their root part) has reached the entry.
function Discovery.reached(e: Entry, pos: Vector3, ctx: Context): boolean
	if e.mode == "water" and (ctx.seated or not ctx.inWater) then
		return false
	elseif e.mode == "foot" and ctx.seated then
		return false
	end
	local d = pos - e.position
	if math.abs(d.Y) > e.maxGap then
		return false
	end
	if e.mode == "water" and d.Y < -e.maxGap * 0.5 then
		return false -- under it (inside the seabed): never
	end
	local a = math.rad(e.yaw)
	local c, s = math.cos(a), math.sin(a)
	local along, across
	if e.terrainAxis then
		-- terrain features (gen_terrain.py): the length runs along (cos yaw, sin yaw) in (x, z)
		along, across = d.X * c + d.Z * s, -d.X * s + d.Z * c
	else
		-- objects built by map/Build.luau at CFrame.Angles(0, yaw, 0): length on the local Z axis
		along, across = d.X * s + d.Z * c, d.X * c - d.Z * s
	end
	return math.abs(along) <= e.length / 2 + e.pad and math.abs(across) <= e.beam / 2 + e.pad
end

-- Found entries for a page (configured now) and its launch target.
function Discovery.pageProgress(
	found: { [string]: boolean },
	pageId: string
): (number, number, number)
	local have, configured = 0, 0
	for _, e in Discovery.Entries do
		if e.page == pageId then
			configured += 1
			if found[e.id] then
				have += 1
			end
		end
	end
	local p = Discovery.page(pageId)
	return have, configured, if p then p.target else configured
end

function Discovery.pageComplete(found: { [string]: boolean }, pageId: string): boolean
	local have, _, target = Discovery.pageProgress(found, pageId)
	return have >= target
end

export type Award = { id: string, cash: number, pages: { Page } }

-- Logs `id` into `found` (mutates) and returns the one-time award, or nil if unknown / already found.
function Discovery.log(found: { [string]: boolean }, id: string): Award?
	local e = byId[id]
	if not e or found[id] then
		return nil
	end
	local wasComplete = Discovery.pageComplete(found, e.page)
	found[id] = true
	local award: Award = { id = id, cash = e.reward, pages = {} }
	if not wasComplete and Discovery.pageComplete(found, e.page) then
		local p = Discovery.page(e.page)
		if p then
			award.cash += p.reward
			table.insert(award.pages, p)
		end
	end
	return award
end

-- Total one-time Cash for every configured entry and page (the farm check: it is finite).
function Discovery.totalCash(): number
	local found: { [string]: boolean } = {}
	local total = 0
	for _, e in Discovery.Entries do
		local a = Discovery.log(found, e.id)
		total += if a then a.cash else 0
	end
	return total
end

-- Profile flags <-> found set.
function Discovery.encode(found: { [string]: boolean }): { [string]: { [string]: boolean } }
	local ids: { string } = {}
	for id, v in found do
		if v and byId[id] then
			table.insert(ids, id)
		end
	end
	table.sort(ids)
	local out: { [string]: { [string]: boolean } } = {}
	for i, id in ids do
		local name = Discovery.FLAG_PREFIX .. tostring(math.ceil(i / Discovery.CHUNK))
		local chunk = out[name]
		if not chunk then
			chunk = {}
			out[name] = chunk
		end
		chunk[id] = true
	end
	return out
end

function Discovery.decode(flags: { [string]: any }?): { [string]: boolean }
	local found: { [string]: boolean } = {}
	if type(flags) ~= "table" then
		return found
	end
	for name, chunk in flags do
		if
			type(name) == "string"
			and string.sub(name, 1, #Discovery.FLAG_PREFIX) == Discovery.FLAG_PREFIX
		then
			if type(chunk) == "table" then
				for id, v in chunk do
					if v == true and type(id) == "string" and byId[id] then
						found[id] = true
					end
				end
			end
		end
	end
	return found
end

return Discovery
