--!strict
-- AssetLoader: loads uploaded Model assets (ids from Shared.Config.AssetIds, generated by
-- tools/gen_asset_ids.py), makes them game-ready once, caches the template in
-- ServerStorage.AssetTemplates and hands out clones. Server only (InsertService).
--
-- Making a template ready (mirrors tools/studio/import_asset.luau, which runs in Edit only):
--   * pivots: Roblox's FBX importer leaves the FBX axis turn (Orientation 90, 0, 0) in each
--     MeshPart's PivotOffset, so PivotTo on a model with a PrimaryPart would tip it 90 degrees.
--     Every part's PivotOffset is re-pointed at the authored pivot (the Blender origin, upright,
--     forward -Z) before PrimaryPart is set, exactly as the importer does;
--   * SurfaceAppearances: map ids can't be written from game scripts, so Rojo builds them into
--     script.Appearances (<asset>/<set>/Dry|Wet) and they are cloned in. Parts with a Wet set keep
--     it in a Configuration "SurfaceVariants" and are tagged "HasWetVariant"; setWet swaps them;
--   * ATT_* markers (parts or attachments) become Attachments on the PrimaryPart; _COL parts and
--     parts of another LOD are removed; visual parts are unanchored, Massless and non-colliding, and
--     small parts cast no shadow. RenderFidelity and CollisionFidelity are Studio-only writes, so
--     the upload's values are kept (Automatic).
-- InsertService:LoadAsset only loads assets the experience owner created (or free ones).

local CollectionService = game:GetService("CollectionService")
local InsertService = game:GetService("InsertService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local AssetIds = require(
	ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"):WaitForChild("AssetIds")
)

local AssetLoader = {}

AssetLoader.WET_TAG = "HasWetVariant"
AssetLoader.COLLISION_TAG = "AssetCollision" -- kept _COL hulls (static assets)
AssetLoader.RETRY_AFTER = 30 -- seconds before a failed load is tried again
local SMALL_PART = 1.5 -- studs; largest axis below this -> CastShadow off

-- Part name token -> texture set, where the set name is not in the part name (from the asset's
-- build specs: art/source/vehicles/<asset>/make_import_setup.py). Default: the longest set name
-- found in the part name, else the only set.
AssetLoader.PART_SETS = {
	M_Veh_RIB = {
		Hull = "Hull",
		Tubes = "Hull",
		Deck = "Deck",
		Console = "Deck",
		AFrame = "Rig",
		Engines = "Rig",
		Decals = "Decals",
	},
	-- art/source/vehicles/M_Veh_JetSki/make_import_setup.py (the close-up set has one set, CloseUp)
	M_Veh_JetSki = {
		Hull = "Hull",
		Seat = "Hull",
		Decals = "Hull",
		Sled = "Sled",
		Fittings = "Sled",
		Bars = "Sled",
	},
} :: { [string]: { [string]: string } }

local appearances = script.Parent:FindFirstChild("Appearances")
local templates: Folder? = nil
local loading: { [string]: boolean } = {}
local failedAt: { [string]: number } = {}

local function templateFolder(): Folder
	if templates and templates.Parent then
		return templates
	end
	local f = ServerStorage:FindFirstChild("AssetTemplates")
	if not (f and f:IsA("Folder")) then
		f = Instance.new("Folder")
		f.Name = "AssetTemplates"
		f.Parent = ServerStorage
	end
	templates = f :: Folder
	return f :: Folder
end

local function numericId(uri: string): number?
	return tonumber(string.match(uri, "(%d+)$"))
end

-- Asset name prefix -> shared texture folder in Appearances (kits that share one atlas, e.g. G1's
-- T_FoliageLand_Main for every M_Veg_* plant)
AssetLoader.SHARED_SETS = { M_Veg_ = "M_Veg_FoliageLand", M_Road_Bench = "M_Road_StreetLamp", M_Road_Bin = "M_Road_StreetLamp", M_Road_Bollard = "M_Road_StreetLamp" } :: { [string]: string }

local function appearanceFolder(asset: string): Instance?
	if not appearances then
		return nil
	end
	local own = (appearances :: Instance):FindFirstChild(asset)
	if own then
		return own
	end
	for prefix, shared in AssetLoader.SHARED_SETS do
		if string.sub(asset, 1, #prefix) == prefix then
			return (appearances :: Instance):FindFirstChild(shared)
		end
	end
	return nil
end

local function setFor(asset: string, partName: string): string?
	local sets = appearanceFolder(asset)
	if not sets then
		return nil
	end
	local tokens = AssetLoader.PART_SETS[asset]
	if tokens then
		for token, set in tokens do
			if
				string.find(partName, "_" .. token .. "_", 1, true)
				or string.find(partName, "_" .. token .. "$")
			then
				return set
			end
		end
	end
	local best: string? = nil
	local only: string? = nil
	local count = 0
	for _, s in sets:GetChildren() do
		count += 1
		only = s.Name
		if
			string.find(string.lower(partName), string.lower(s.Name), 1, true)
			and (not best or #s.Name > #best)
		then
			best = s.Name
		end
	end
	return best or (if count == 1 then only else nil)
end

local function applyAppearance(asset: string, part: MeshPart)
	local setName = setFor(asset, part.Name)
	local set = setName and appearanceFolder(asset)
	set = set and set:FindFirstChild(setName :: string)
	if not set then
		warn(`[AssetLoader] {asset}: no texture set for {part.Name}`)
		return
	end
	for _, old in part:GetChildren() do
		if old:IsA("SurfaceAppearance") or old.Name == "SurfaceVariants" then
			old:Destroy()
		end
	end
	local dry = set:FindFirstChild("Dry")
	if dry then
		local sa = dry:Clone()
		sa.Name = "SurfaceAppearance"
		sa.Parent = part
	end
	local wet = set:FindFirstChild("Wet")
	if wet then
		local variants = Instance.new("Configuration")
		variants.Name = "SurfaceVariants"
		local sa = wet:Clone()
		sa.Name = "SurfaceAppearance_Wet"
		sa.Parent = variants
		variants.Parent = part
		part:SetAttribute("WetState", false)
		CollectionService:AddTag(part, AssetLoader.WET_TAG)
	end
end

-- Vehicles and characters are welded, unanchored assemblies: their _COL hulls are dropped (the greybox
-- body collides). Buildings, rocks and props keep them for cloneStatic.
local function keepCollision(asset: string): boolean
	local kind = string.sub(asset, 1, 6)
	return kind ~= "M_Veh_" and kind ~= "M_Chr_"
end

local function prepare(asset: string, lod: string, model: Model): Model
	model.Name = `{asset}_{lod}`
	-- the authored pivot (the upload has no PrimaryPart, so WorldPivot is stored, not derived)
	local authored = model.WorldPivot
	local markers: { { name: string, cf: CFrame } } = {}
	local primary: BasePart? = nil
	local bestVolume = -1
	for _, d in model:GetDescendants() do
		if d:IsA("Attachment") and string.sub(d.Name, 1, 4) == "ATT_" then
			table.insert(markers, { name = d.Name, cf = d.WorldCFrame })
			d:Destroy()
		elseif d:IsA("BasePart") then
			local name = d.Name
			local otherLod = string.match(name, "_(LOD%d)$")
			if string.sub(name, 1, 4) == "ATT_" then
				table.insert(markers, { name = name, cf = d.CFrame })
				d:Destroy()
			elseif string.match(name, "_COL$") and keepCollision(asset) then
				-- static assets keep their collision hull: invisible and inert here, cloneStatic turns it on
				d.Transparency = 1
				d.Anchored = false
				d.CanCollide = false
				d.CanTouch = false
				d.CanQuery = false
				d.CastShadow = false
				d.Massless = true
				d:AddTag(AssetLoader.COLLISION_TAG)
				for _, k in d:GetChildren() do
					if k:IsA("SurfaceAppearance") then
						k:Destroy()
					end
				end
			elseif string.match(name, "_COL$") or (otherLod and otherLod ~= lod) then
				d:Destroy()
			else
				d.PivotOffset = d.CFrame:ToObjectSpace(authored)
				d.Anchored = false
				d.CanCollide = false
				d.CanTouch = false
				d.CanQuery = false
				d.Massless = true
				local size = d.Size
				if math.max(size.X, size.Y, size.Z) < SMALL_PART then
					d.CastShadow = false
				end
				if d:IsA("MeshPart") then
					applyAppearance(asset, d)
				end
				local volume = size.X * size.Y * size.Z
				if volume > bestVolume then
					bestVolume = volume
					primary = d
				end
			end
		end
	end
	if primary then
		model.PrimaryPart = primary
		model.WorldPivot = authored
		for _, m in markers do
			local a = Instance.new("Attachment")
			a.Name = m.name
			a.CFrame = primary.CFrame:ToObjectSpace(m.cf)
			a.Parent = primary
		end
		-- Roblox's FBX import drops empties, so most uploads carry no ATT_ markers: add the ones
		-- gen_asset_ids.py read from the export (AssetIds.Attachments, studs from the authored pivot)
		local listed = (AssetIds :: any).Attachments and (AssetIds :: any).Attachments[asset]
		for name, offset in listed or {} do
			if typeof(offset) == "Vector3" and not primary:FindFirstChild(name) then
				local a = Instance.new("Attachment")
				a.Name = name
				a.CFrame = primary.CFrame:ToObjectSpace(authored * CFrame.new(offset))
				a.Parent = primary
			end
		end
		-- sanity: a vessel is never tallest along its up axis (the box is in pivot space)
		local _, size = model:GetBoundingBox()
		if string.sub(asset, 1, 6) == "M_Veh_" and size.Y > math.max(size.X, size.Z) then
			warn(`[AssetLoader] {asset}: tallest along Y after the pivot fix ({size}); tilted?`)
		end
	end
	model:SetAttribute("Asset", asset)
	model:SetAttribute("Lod", lod)
	return model
end

local function load(asset: string, lod: string): Model?
	local lods = AssetIds.Models[asset]
	local uri = lods and lods[lod]
	local id = uri and numericId(uri)
	if not id then
		warn(`[AssetLoader] no asset id for {asset} {lod} (run tools/gen_asset_ids.py)`)
		return nil
	end
	local ok, result = pcall(InsertService.LoadAsset, InsertService, id)
	if not ok or typeof(result) ~= "Instance" then
		warn(`[AssetLoader] LoadAsset {asset} {lod} ({id}) failed: {result}`)
		return nil
	end
	local container = result :: Instance
	local model: Model? = nil
	local kids = container:GetChildren()
	if #kids == 1 and kids[1]:IsA("Model") then
		local inner = kids[1] :: Model
		inner.Parent = nil
		container:Destroy()
		model = inner
	elseif container:IsA("Model") then
		model = container
	end
	if not model or not model:FindFirstChildWhichIsA("BasePart", true) then
		warn(`[AssetLoader] {asset} {lod} ({id}) has no parts`)
		container:Destroy()
		return nil
	end
	return prepare(asset, lod, model)
end

-- The cached, game-ready template (do not modify; clone it). Yields on the first call per asset.
-- nil when the asset can't be loaded (warned; retried after RETRY_AFTER seconds).
function AssetLoader.getTemplate(asset: string, lod: string?): Model?
	local l = lod or "LOD0"
	local key = `{asset}_{l}`
	local folder = templateFolder()
	while loading[key] do
		task.wait()
	end
	local cached = folder:FindFirstChild(key)
	if cached and cached:IsA("Model") then
		return cached
	end
	if failedAt[key] and os.clock() - failedAt[key] < AssetLoader.RETRY_AFTER then
		return nil
	end
	loading[key] = true
	local ok, model = pcall(load, asset, l)
	loading[key] = nil
	if not ok then
		warn(`[AssetLoader] preparing {key} failed: {model}`)
		model = nil
	end
	if not model then
		failedAt[key] = os.clock()
		return nil
	end
	failedAt[key] = nil
	model.Parent = folder
	return model
end

-- A fresh copy of the asset at its authored pivot (parts unanchored), or nil (see getTemplate).
function AssetLoader.clone(asset: string, lod: string?): Model?
	local template = AssetLoader.getTemplate(asset, lod)
	return if template then template:Clone() else nil
end

-- A copy for static world placement (buildings, rocks, plants): every part Anchored; the _COL hull (when
-- the upload has one) collides and is queryable; when `collide` is false (plants) nothing collides.
-- With no _COL hull and collide true, the visual parts collide instead (Automatic fidelity).
function AssetLoader.cloneStatic(asset: string, lod: string?, collide: boolean?): Model?
	local copy = AssetLoader.clone(asset, lod)
	if not copy then
		return nil
	end
	local solid = collide ~= false
	local hasHull = false
	for _, d in copy:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			if d:HasTag(AssetLoader.COLLISION_TAG) then
				hasHull = true
				d.CanCollide = solid
				d.CanQuery = solid
			end
		end
	end
	if solid and not hasHull then
		for _, d in copy:GetDescendants() do
			if d:IsA("BasePart") then
				d.CanCollide = true
				d.CanQuery = true
			end
		end
	end
	return copy
end

-- Loads templates in the background (call at server start so the first spawn doesn't wait).
function AssetLoader.preload(assets: { string })
	for _, asset in assets do
		task.spawn(AssetLoader.getTemplate, asset, "LOD0")
	end
end

-- Swaps every HasWetVariant part under `root` to its _Wet (or dry) SurfaceAppearance.
function AssetLoader.setWet(root: Instance, wet: boolean)
	for _, part in root:GetDescendants() do
		if not (part:IsA("BasePart") and CollectionService:HasTag(part, AssetLoader.WET_TAG)) then
			continue
		end
		if (part:GetAttribute("WetState") == true) == wet then
			continue
		end
		local variants = part:FindFirstChild("SurfaceVariants")
		local stored = variants
			and variants:FindFirstChild(
				if wet then "SurfaceAppearance_Wet" else "SurfaceAppearance_Dry"
			)
		local active = part:FindFirstChildWhichIsA("SurfaceAppearance")
		if not (variants and stored and active) then
			continue
		end
		active.Name = if wet then "SurfaceAppearance_Dry" else "SurfaceAppearance_Wet"
		active.Parent = variants
		stored.Name = "SurfaceAppearance"
		stored.Parent = part
		part:SetAttribute("WetState", wet)
	end
end

return AssetLoader
