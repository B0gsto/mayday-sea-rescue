-- Text of a line id, or nil when the id is unknown.
function RadioLines.text(id: string): string?
	local pre, rest = string.match(id, "^(%u+)_(.+)$")
	if not pre or not rest then
		return nil
	end
	local own = RadioLines.Other[id]
	if own then
		return own
	end
	if pre == "CGD" or pre == "CGN" then
		return RadioLines.Coastguard[rest]
	end
	if pre == "PLM" or pre == "PLF" then
		return RadioLines.Player[rest]
	end
	return nil
end

-- stylua: ignore end
return RadioLines
