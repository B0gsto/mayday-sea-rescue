-- 5. preload: every K1 SurfaceAppearance instance (dry on the parts + wet in SurfaceVariants) and the cove's terrain
-- MaterialVariants, polled on GetAssetFetchStatus until all Success (freshly approved maps NetFail / stay white on
-- the first fetch: the round-0 Clear_wet blow-out)
local MAPS = { "ColorMap", "NormalMap", "RoughnessMap", "MetalnessMap" }
local function k1Preload(timeout: number): (number, number, number)
	local inst, uris, seen = {}, {}, {}
	for _, dd in workspace:GetDescendants() do
		if dd:IsA("SurfaceAppearance") and string.find(dd:GetFullName(), "M_Rock_", 1, true) then table.insert(inst, dd) end
	end
	for _, mv in MS:GetChildren() do
		if mv:IsA("MaterialVariant") then table.insert(inst, mv) end
	end
	for _, s in inst do
		for _, k in MAPS do
			local ok, v = pcall(function() return (s :: any)[k] end)
			if ok and type(v) == "string" and v ~= "" and not seen[v] then seen[v] = true table.insert(uris, v) end
		end
	end
	local t0 = os.clock()
	local bad = #uris
	for attempt = 1, 6 do
		local list = table.clone(inst)
		for _, id in uris do local dec = Instance.new("Decal") dec.Texture = id table.insert(list, dec) end
		local done = false
		task.spawn(function() pcall(function() CP:PreloadAsync(list) end) done = true end)
		while not done and os.clock() - t0 < timeout do task.wait(0.25) end
		bad = 0
		for _, id in uris do
			local ok, st = pcall(function() return CP:GetAssetFetchStatus(id) end)
			if not (ok and st == Enum.AssetFetchStatus.Success) then bad += 1 end
		end
		if bad == 0 or os.clock() - t0 > timeout then break end
		task.wait(1.5)
	end
	return #inst, #uris, bad
end
_G.K1Preload = k1Preload
local stage = workspace:WaitForChild("K1Stage", 30)
local function lampOf(name: string): SpotLight return (stage:WaitForChild(name, 30) :: any):WaitForChild("SpotLight", 30) end
local key, fill = lampOf("ShotKey"), lampOf("ShotFill")
local over = { lampOf("CoveFill1"), lampOf("CoveFill2"), lampOf("CoveFill3") }
local LIFT = { Clear = {-0.2, 0, 0, 0}, Overcast = {0.1, 0.6, 0.3, 0}, Storm = {0.5, 1.4, 0.7, 0.35}, Night = {0.55, 1.6, 0.8, 0.45} } -- EV, key, fill, cove
_G.K1Shot = function(preset: string, wet: boolean, cam: {number}, look: {number}): string
	local r = _G.LookDev.apply(preset, wet)
	local b = LIFT[preset] or {0, 0, 0, 0}
	Lighting.ExposureCompensation += b[1]
	if preset == "Storm" or preset == "Night" then
		local oa = Lighting.OutdoorAmbient
		Lighting.OutdoorAmbient = Color3.new(math.max(oa.R, 0.30), math.max(oa.G, 0.32), math.max(oa.B, 0.36))
		local am = Lighting.Ambient
		Lighting.Ambient = Color3.new(math.max(am.R, 0.16), math.max(am.G, 0.17), math.max(am.B, 0.2))
	end
	local c, l = Vector3.new(cam[1], cam[2], cam[3]), Vector3.new(look[1], look[2], look[3])
	local cf = CFrame.lookAt(c, l)
	local dist = (l - c).Magnitude
	local k = math.clamp(dist * 0.3, 1, 8)
	key.Parent.CFrame = CFrame.lookAt(c - cf.RightVector * k + cf.UpVector * k * 0.8, l)
	fill.Parent.CFrame = CFrame.lookAt(c + cf.RightVector * k * 1.2 - cf.UpVector * k * 0.15, l)
	local near = dist < 58
	key.Brightness, fill.Brightness = b[2], b[3]
	key.Enabled, fill.Enabled = near and b[2] > 0, near and b[3] > 0
	for _, o in over do o.Brightness = b[4] o.Range = 60 o.Enabled = b[4] > 0 end
	local ni, nu, bad = k1Preload(25)
	return string.format("%s | EV +%.2f | rig %s key %.1f fill %.1f cove %.1f @%.0f | preload %d sa, %d maps, %d not loaded",
		r, b[1], if near then "on" else "off", b[2], b[3], b[4], dist, ni, nu, bad)
end
-- 7. parts that render untextured: visible MeshParts in the K1 models without an active SurfaceAppearance
local function untextured(): string
	local out = {}
	for _, m in workspace:GetDescendants() do
		if m:IsA("Model") and string.match(m.Name, "^M_Rock_") and not m:FindFirstAncestor("LookDevPreload") then
			for _, d in m:GetDescendants() do
				if d:IsA("MeshPart") and d.Transparency < 1 and d.LocalTransparencyModifier < 1 then
					local sa = d:FindFirstChildOfClass("SurfaceAppearance")
					if not sa or sa.ColorMap == "" then
						table.insert(out, d:GetFullName() .. (if sa then "(SA no ColorMap)" else "(no SA)"))
					end
				end
			end
		end
	end
	return if #out > 0 then table.concat(out, ", ") else "none"
end
_G.K1Untextured = untextured
local function k1Aim(names: {string}, sea: number?, side: number?): ({number}, {number}, string)
	local rp = RaycastParams.new() rp.FilterType = Enum.RaycastFilterType.Include rp.FilterDescendantsInstances = { workspace.Terrain }
	local best, bestCf, bestSize, bestUp, info = nil, nil, nil, -math.huge, {}
	for _, nm in names do
		local m = workspace:FindFirstChild(nm, true)
		if m and m:IsA("Model") then
			local cf, size = m:GetBoundingBox()
			local hit = workspace:Raycast(cf.Position + Vector3.new(0, size.Y + 60, 0), Vector3.new(0, -(size.Y + 140), 0), rp)
			local ground = math.max(if hit then hit.Position.Y else -100, 0)
			local up = cf.Position.Y + size.Y / 2 - ground
			table.insert(info, string.format("%s c(%.1f,%.1f,%.1f) s(%.1f,%.1f,%.1f) ground %.1f exposed %.1f", nm, cf.Position.X, cf.Position.Y, cf.Position.Z, size.X, size.Y, size.Z, ground, up))
			if up > bestUp then best, bestCf, bestSize, bestUp = m, cf, size, up end
		end
	end
	if not best then return {0, 0, 0}, {0, 0, 1}, "no target" end
	local right = Vector3.new(-D.Z, 0, D.X)
	local cands = {}
	for _, nm in names do
		local m = workspace:FindFirstChild(nm, true)
		if m and m:IsA("Model") then
			local cf, size = m:GetBoundingBox()
			local hit = workspace:Raycast(cf.Position + Vector3.new(0, size.Y + 60, 0), Vector3.new(0, -(size.Y + 140), 0), rp)
			table.insert(cands, { m = m, cf = cf, size = size, up = cf.Position.Y + size.Y / 2 - math.max(if hit then hit.Position.Y else -100, 0) })
		end
	end
	table.sort(cands, function(a, b) return a.up > b.up end)
	local cam, look, hitName, tries = nil, nil, "none", 0
	local seaward = math.atan2(D.Z, D.X)
	for _, cd in cands do
		local c = cd.cf.Position
		local r = math.max(cd.size.X, cd.size.Z) * 0.5
		local dist = r * 2.2 + 8
		local lk = c + Vector3.new(0, cd.size.Y * 0.1, 0)
		for _, hm in { 1, 2 } do
			for k = 0, 7 do
				local az = seaward + math.rad(({ 20, -20, 60, -60, 100, -100, 150, -150 })[k + 1])
				local cnd = c + Vector3.new(math.cos(az), 0, math.sin(az)) * dist + Vector3.new(0, (math.max(cd.size.Y, 3) + 3) * hm, 0)
				local hit = workspace:Raycast(cnd, (lk - cnd) * 1.02)
				tries += 1
				if not cam then cam, look, best = cnd, lk, cd.m end
				if hit and hit.Instance:IsDescendantOf(cd.m) then
					cam, look, best, hitName = cnd, lk, cd.m, hit.Instance:GetFullName()
					break
				end
			end
			if hitName ~= "none" then break end
		end
		if hitName ~= "none" then break end
	end
	workspace:SetAttribute("ShotCF", CFrame.lookAt(cam, look))
	return {cam.X, cam.Y, cam.Z}, {look.X, look.Y, look.Z}, best.Name .. " ray-> " .. hitName .. " (" .. tries .. " tries) | " .. table.concat(info, "; ")
end
_G.K1Aim = k1Aim
