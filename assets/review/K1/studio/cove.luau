-- 3. paint (shape kept: ReplaceMaterial by height band), then sand patches
local SRC = { Enum.Material.Basalt, Enum.Material.Asphalt, Enum.Material.Ground, Enum.Material.Grass, Enum.Material.LeafyGrass, Enum.Material.Rock }
local function band(y0: number, y1: number, target: Enum.Material, half: number)
	local reg = Region3.new(W + Vector3.new(-half, y0, -half), W + Vector3.new(half, y1, half)):ExpandToGrid(4)
	for _, m in SRC do if m ~= target then pcall(function() Terrain:ReplaceMaterial(reg, 4, m, target) end) end end
end
band(-12, 0, Enum.Material.Slate, 60)       -- KelpRock: intertidal, wrack-covered
band(0, 2, Enum.Material.Basalt, 60)        -- SplashRock (re-graded): wet rock in the splash band
band(2, 40, Enum.Material.Pebble, 60)       -- Shingle above the splash band
local rng = Random.new(1871)
for _ = 1, 26 do                            -- dry sand pockets in the shingle (and wet sand at the swash line)
	local c = W + Vector3.new(rng:NextNumber(-44, 44), 0, rng:NextNumber(-44, 44))
	local s = rng:NextInteger(2, 4) * 4
	local reg = Region3.new(c + Vector3.new(-s, -1, -s), c + Vector3.new(s, 24, s)):ExpandToGrid(4)
	pcall(function() Terrain:ReplaceMaterial(reg, 4, Enum.Material.Pebble, Enum.Material.Sand) end)
	local reg2 = Region3.new(c + Vector3.new(-s, -2, -s), c + Vector3.new(s, 2, s)):ExpandToGrid(4)
	pcall(function() Terrain:ReplaceMaterial(reg2, 4, Enum.Material.Basalt, Enum.Material.Sandstone) end)
end
-- 4. place the pieces; under each, a pad of terrain up to <bury> of its height (bases sunk 15-30 %) and a skirt of
-- shingle / wet rock balls round the footprint (the contact transition; shingle at the waterline on the shore pieces)
local n = 0
for name, p in P do
	local m = workspace:FindFirstChild(name, true)
	if m and m:IsA("Model") then
		if p[5] ~= 1 then m:ScaleTo(p[5]) end
		local cf = CFrame.new(p[1], p[2], p[3]) * CFrame.Angles(0, math.rad(p[4]), 0)
		m:PivotTo(cf)
		local sx, sz, h, bury, water = p[6], p[7], p[8], p[9], p[10]
		local top = p[2] + h * bury
		local pad = if water then Enum.Material.Slate else Enum.Material.Pebble
		Terrain:FillBlock(cf * CFrame.new(0, (top - p[2]) / 2 - 3, 0), Vector3.new(sx * 0.62, top - p[2] + 6, sz * 0.62), pad)
		local ring = math.clamp(math.floor((sx + sz) / 3), 6, 24)
		for i = 1, ring do
			local a = (i / ring) * math.pi * 2 + rng:NextNumber(-0.2, 0.2)
			local off = Vector3.new(math.cos(a) * sx * 0.5, 0, math.sin(a) * sz * 0.5)
			local wp = (cf * CFrame.new(off)).Position
			local y = if water then rng:NextNumber(-0.6, 0.4) else top - rng:NextNumber(0.4, 1.2)
			local rad = rng:NextNumber(1.2, 2.4) * math.clamp(h / 8, 0.7, 1.6)
			Terrain:FillBall(Vector3.new(wp.X, y, wp.Z), rad, if water and y < 0.2 then Enum.Material.Basalt else Enum.Material.Pebble)
		end
		n += 1
	end
end
-- 6. per-shot driver: preset + wet, then the fill: Storm / Night readability lift (exposure + ambient) and, on close-ups,
-- a camera key / fill pair re-aimed at the look point (as the Bosun / RIB passes); three overhead cove fills at Night
local stage = Instance.new("Folder") stage.Name = "K1Stage" stage.Parent = workspace
local function lamp(name: string, shadows: boolean): SpotLight
	local pt = Instance.new("Part")
	pt.Name = name pt.Anchored = true pt.Size = Vector3.one * 0.2 pt.Transparency = 1
	pt.CanCollide = false pt.CanQuery = false pt.CanTouch = false pt.CastShadow = false pt.Parent = stage
	local l = Instance.new("SpotLight") l.Face = Enum.NormalId.Front l.Angle = 70 l.Range = 60 l.Brightness = 0
	l.Color = Color3.fromRGB(255, 240, 222) l.Shadows = shadows l.Enabled = false l.Parent = pt
	return l
end
local key, fill = lamp("ShotKey", true), lamp("ShotFill", false)
