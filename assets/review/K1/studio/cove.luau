-- 1. probe: which terrain material + MaterialService override sits under the cove (before any paint)
local function probe(): string
	local lo, hi = W + Vector3.new(-48, -8, -48), W + Vector3.new(48, 16, 48)
	local reg = Region3.new(lo, hi):ExpandToGrid(4)
	local mats, occ = Terrain:ReadVoxels(reg, 4)
	local cnt = {}
	for i = 1, #mats do for j = 1, #mats[i] do for k = 1, #mats[i][j] do
		local m = mats[i][j][k]
		if m ~= Enum.Material.Air and m ~= Enum.Material.Water and occ[i][j][k] > 0.5 then cnt[m.Name] = (cnt[m.Name] or 0) + 1 end
	end end end
	local out = {}
	for name, c in cnt do
		local ok, ov = pcall(function() return MS:GetBaseMaterialOverride(Enum.Material[name]) end)
		local mv = ok and ov ~= "" and MS:FindFirstChild(ov)
		table.insert(out, string.format("%s=%d->%s[%s]", name, c, if ok then tostring(ov) else "?",
			if mv and mv:IsA("MaterialVariant") then string.match(mv.ColorMap, "%d+$") or "?" else "-"))
	end
	table.sort(out)
	return table.concat(out, " ")
end
local probeReport = probe()
-- 2. the re-graded SplashRock (B02 fix, K1 round 1) live in this session even if the place file predates it
