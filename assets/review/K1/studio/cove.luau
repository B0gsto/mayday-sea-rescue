local W = Vector3.new(-505.17, 0, 22.83)
local D = Vector3.new(0.7071, 0, 0.7071)
local SPLASH = {["SplashRock"] = "95741801877113", ["SplashRock_Wet"] = "76054759137057"}
local Terrain = workspace.Terrain
