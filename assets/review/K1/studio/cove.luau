-- K1 test cove on the real terrain (generated by make_studio.py)
local P = {}
P["M_Rock_Ledge_01"] = {-492.44, -1.68, 12.93, -45.0, 1.00}
P["M_Rock_Ledge_02"] = {-512.95, -1.83, 34.85, -125.0, 1.00}
P["M_Rock_Ledge_03"] = {-495.27, -1.60, 31.31, -95.0, 1.00}
P["M_Rock_Boulder_04"] = {-508.00, -1.06, 24.24, -115.0, 1.00}
P["M_Rock_Boulder_05"] = {-506.59, 2.77, 11.51, -75.0, 1.00}
P["M_Rock_Boulder_06"] = {-520.73, -4.02, 22.83, -5.0, 1.00}
P["M_Rock_Boulder_01"] = {-509.41, 3.05, 20.00, 65.0, 1.00}
P["M_Rock_Boulder_02"] = {-503.76, 3.46, 17.17, -60.0, 1.00}
P["M_Rock_Boulder_03"] = {-515.07, -3.20, 22.83, 165.0, 1.00}
P["M_Rock_Cliff_01"] = {-510.83, -3.89, -8.28, -135.0, 2.50}
P["M_Rock_Cliff_03"] = {-529.92, -10.08, 5.15, -135.0, 1.50}
P["M_Rock_Cliff_02"] = {-540.53, -1.20, 24.24, 45.0, 2.00}
P["M_Rock_Cliff_04"] = {-489.62, -6.75, -12.53, -135.0, 1.50}
P["M_Rock_Cliff_05"] = {-540.53, -4.50, 46.87, -45.0, 1.00}
local n = 0
for name, p in P do
	local m = workspace:FindFirstChild(name, true)
	if m and m:IsA("Model") then
		if p[5] ~= 1 then m:ScaleTo(p[5]) end
		m:PivotTo(CFrame.new(p[1], p[2], p[3]) * CFrame.Angles(0, math.rad(p[4]), 0))
		n += 1
	end
end
local CP = game:GetService("ContentProvider")
local ids, seen = {}, {}
for _, dd in workspace:GetDescendants() do
	if dd:IsA("SurfaceAppearance") and string.find(dd:GetFullName(), "M_Rock_", 1, true) then
		for _, k in { "ColorMap", "NormalMap", "RoughnessMap", "MetalnessMap" } do
			local ok, v = pcall(function() return dd[k] end)
			if ok and type(v) == "string" and v ~= "" and not seen[v] then seen[v] = true table.insert(ids, v) end
		end
	end
end
local failed = 0
for attempt = 1, 3 do
	local list, bad = {}, 0
	for _, id in ids do local dec = Instance.new("Decal") dec.Texture = id table.insert(list, dec) end
	pcall(function() CP:PreloadAsync(list, function(_, s) if s ~= Enum.AssetFetchStatus.Success then bad += 1 end end) end)
	failed = bad
	if bad == 0 then break end
	task.wait(2)
end
return string.format("K1 cove: placed %d, maps %d, failed %d", n, #ids, failed)
