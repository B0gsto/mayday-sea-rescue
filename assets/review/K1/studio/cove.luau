-- 3. paint (shape kept: ReplaceMaterial by height band), then sand patches
local SRC = { Enum.Material.Basalt, Enum.Material.Asphalt, Enum.Material.Ground, Enum.Material.Grass, Enum.Material.LeafyGrass, Enum.Material.Rock }
local function band(y0: number, y1: number, target: Enum.Material, half: number)
	local reg = Region3.new(W + Vector3.new(-half, y0, -half), W + Vector3.new(half, y1, half)):ExpandToGrid(4)
	for _, m in SRC do if m ~= target then pcall(function() Terrain:ReplaceMaterial(reg, 4, m, target) end) end end
end
band(-12, 0, Enum.Material.Slate, 60)       -- KelpRock: intertidal, wrack-covered
band(0, 2, Enum.Material.Basalt, 60)        -- SplashRock (re-graded): wet rock in the splash band
band(2, 40, Enum.Material.Pebble, 60)       -- Shingle above the splash band
local rng = Random.new(1871)
for _ = 1, 26 do                            -- dry sand pockets in the shingle (and wet sand at the swash line)
	local c = W + Vector3.new(rng:NextNumber(-44, 44), 0, rng:NextNumber(-44, 44))
	local s = rng:NextInteger(2, 4) * 4
	local reg = Region3.new(c + Vector3.new(-s, -1, -s), c + Vector3.new(s, 24, s)):ExpandToGrid(4)
	pcall(function() Terrain:ReplaceMaterial(reg, 4, Enum.Material.Pebble, Enum.Material.Sand) end)
	local reg2 = Region3.new(c + Vector3.new(-s, -2, -s), c + Vector3.new(s, 2, s)):ExpandToGrid(4)
	pcall(function() Terrain:ReplaceMaterial(reg2, 4, Enum.Material.Basalt, Enum.Material.Sandstone) end)
end
-- 4. place the pieces; under each, a pad of terrain up to <bury> of its height (bases sunk 15-30 %) and a skirt of
-- shingle / wet rock balls round the footprint (the contact transition; shingle at the waterline on the shore pieces)
local n = 0
for name, p in P do
	local m = workspace:FindFirstChild(name, true)
	if m and m:IsA("Model") then
		if p[5] ~= 1 then m:ScaleTo(p[5]) end
		local cf = CFrame.new(p[1], p[2], p[3]) * CFrame.Angles(0, math.rad(p[4]), 0)
		m:PivotTo(cf)
		local sx, sz, h, bury, water = p[6], p[7], p[8], p[9], p[10]
		local top = p[2] + h * bury
		local pad = if water then Enum.Material.Slate else Enum.Material.Pebble
		Terrain:FillBlock(cf * CFrame.new(0, (top - p[2]) / 2 - 3, 0), Vector3.new(sx * 0.62, top - p[2] + 6, sz * 0.62), pad)
		local ring = math.clamp(math.floor((sx + sz) / 3), 6, 24)
		for i = 1, ring do
			local a = (i / ring) * math.pi * 2 + rng:NextNumber(-0.2, 0.2)
			local off = Vector3.new(math.cos(a) * sx * 0.5, 0, math.sin(a) * sz * 0.5)
			local wp = (cf * CFrame.new(off)).Position
			local y = if water then rng:NextNumber(-0.6, 0.4) else top - rng:NextNumber(0.4, 1.2)
			local rad = rng:NextNumber(1.2, 2.4) * math.clamp(h / 8, 0.7, 1.6)
			Terrain:FillBall(Vector3.new(wp.X, y, wp.Z), rad, if water and y < 0.2 then Enum.Material.Basalt else Enum.Material.Pebble)
		end
		n += 1
	end
end
-- 5. preload: every K1 SurfaceAppearance instance (dry on the parts + wet in SurfaceVariants) and the cove's terrain
-- MaterialVariants, polled on GetAssetFetchStatus until all Success (freshly approved maps NetFail / stay white on
-- the first fetch: the round-0 Clear_wet blow-out)
local MAPS = { "ColorMap", "NormalMap", "RoughnessMap", "MetalnessMap" }
local function k1Preload(timeout: number): (number, number, number)
	local inst, uris, seen = {}, {}, {}
	for _, dd in workspace:GetDescendants() do
		if dd:IsA("SurfaceAppearance") and string.find(dd:GetFullName(), "M_Rock_", 1, true) then table.insert(inst, dd) end
	end
	for _, mv in MS:GetChildren() do
		if mv:IsA("MaterialVariant") then table.insert(inst, mv) end
	end
	for _, s in inst do
		for _, k in MAPS do
			local ok, v = pcall(function() return (s :: any)[k] end)
			if ok and type(v) == "string" and v ~= "" and not seen[v] then seen[v] = true table.insert(uris, v) end
		end
	end
	local t0 = os.clock()
	local bad = #uris
	for attempt = 1, 6 do
		local list = table.clone(inst)
		for _, id in uris do local dec = Instance.new("Decal") dec.Texture = id table.insert(list, dec) end
		local done = false
		task.spawn(function() pcall(function() CP:PreloadAsync(list) end) done = true end)
		while not done and os.clock() - t0 < timeout do task.wait(0.25) end
		bad = 0
		for _, id in uris do
			local ok, st = pcall(function() return CP:GetAssetFetchStatus(id) end)
			if not (ok and st == Enum.AssetFetchStatus.Success) then bad += 1 end
		end
		if bad == 0 or os.clock() - t0 > timeout then break end
		task.wait(1.5)
	end
	return #inst, #uris, bad
end
_G.K1Preload = k1Preload
-- 6. per-shot driver: preset + wet, then the fill: Storm / Night readability lift (exposure + ambient) and, on close-ups,
-- a camera key / fill pair re-aimed at the look point (as the Bosun / RIB passes); three overhead cove fills at Night
local stage = Instance.new("Folder") stage.Name = "K1Stage" stage.Parent = workspace
local function lamp(name: string, shadows: boolean): SpotLight
	local pt = Instance.new("Part")
	pt.Name = name pt.Anchored = true pt.Size = Vector3.one * 0.2 pt.Transparency = 1
	pt.CanCollide = false pt.CanQuery = false pt.CanTouch = false pt.CastShadow = false pt.Parent = stage
	local l = Instance.new("SpotLight") l.Face = Enum.NormalId.Front l.Angle = 70 l.Range = 60 l.Brightness = 0
	l.Color = Color3.fromRGB(255, 240, 222) l.Shadows = shadows l.Enabled = false l.Parent = pt
	return l
end
local key, fill = lamp("ShotKey", true), lamp("ShotFill", false)
local over = {}
for i, o in { Vector3.new(-14, 0, -20), Vector3.new(-18, 0, 6), Vector3.new(-12, 0, 30) } do
	local l = lamp("CoveFill" .. i, false)
	local pos = W + D * o.X + Vector3.new(-D.Z, 0, D.X) * o.Z
	l.Parent.CFrame = CFrame.lookAt(pos + Vector3.new(0, 45, 0) + D * 20, pos) l.Angle = 90
	l.Color = Color3.fromRGB(196, 214, 255)
	table.insert(over, l)
end
local LIFT = { Clear = {-0.2, 0, 0, 0}, Overcast = {0.1, 0.6, 0.3, 0}, Storm = {0.5, 1.4, 0.7, 0.35}, Night = {0.55, 1.6, 0.8, 0.45} } -- EV, key, fill, cove
_G.K1Shot = function(preset: string, wet: boolean, cam: {number}, look: {number}): string
	local r = _G.LookDev.apply(preset, wet)
	local b = LIFT[preset] or {0, 0, 0, 0}
	Lighting.ExposureCompensation += b[1]
	if preset == "Storm" or preset == "Night" then
		local oa = Lighting.OutdoorAmbient
		Lighting.OutdoorAmbient = Color3.new(math.max(oa.R, 0.30), math.max(oa.G, 0.32), math.max(oa.B, 0.36))
		local am = Lighting.Ambient
		Lighting.Ambient = Color3.new(math.max(am.R, 0.16), math.max(am.G, 0.17), math.max(am.B, 0.2))
	end
	local c, l = Vector3.new(cam[1], cam[2], cam[3]), Vector3.new(look[1], look[2], look[3])
	local cf = CFrame.lookAt(c, l)
	local dist = (l - c).Magnitude
	local k = math.clamp(dist * 0.3, 1, 8)
	key.Parent.CFrame = CFrame.lookAt(c - cf.RightVector * k + cf.UpVector * k * 0.8, l)
	fill.Parent.CFrame = CFrame.lookAt(c + cf.RightVector * k * 1.2 - cf.UpVector * k * 0.15, l)
	local near = dist < 58
	key.Brightness, fill.Brightness = b[2], b[3]
	key.Enabled, fill.Enabled = near and b[2] > 0, near and b[3] > 0
	for _, o in over do o.Brightness = b[4] o.Range = 60 o.Enabled = b[4] > 0 end
	local ni, nu, bad = k1Preload(25)
	return string.format("%s | EV +%.2f | rig %s key %.1f fill %.1f cove %.1f @%.0f | preload %d sa, %d maps, %d not loaded",
		r, b[1], if near then "on" else "off", b[2], b[3], b[4], dist, ni, nu, bad)
end
local ni, nu, bad = k1Preload(60)
return string.format("K1 cove: placed %d | probe %s | preload %d sa, %d maps, %d not loaded", n, probeReport, ni, nu, bad)
