-- CameraTransitionMath: the close-work dolly curve, lens dip, body fade and path clamps.
return function(t)
	local M = t.load("src/client/Camera/TransitionMath.luau")

	t.test("ease is slow at both ends and symmetric", function()
		t.expect(M.ease(0)).toBeCloseTo(0, 1e-9)
		t.expect(M.ease(0.5)).toBeCloseTo(0.5, 1e-9)
		t.expect(M.ease(1)).toBeCloseTo(1, 1e-9)
		t.expect(M.ease(0.25)).toBeCloseTo(1 - M.ease(0.75), 1e-9)
		t.expect(M.ease(0.25) < 0.25).toBeTruthy()
		t.expect(M.ease(0.75) > 0.75).toBeTruthy()
	end)

	t.test("ease climbs monotonically and clamps outside 0..1", function()
		local last = -1
		for i = 0, 20 do
			local v = M.ease(i / 20)
			t.expect(v >= last).toBeTruthy()
			last = v
		end
		t.expect(M.ease(-2)).toBeCloseTo(0, 1e-9)
		t.expect(M.ease(3)).toBeCloseTo(1, 1e-9)
	end)

	t.test("the dolly starts and ends on its points, lifting only in between", function()
		local a = Vector3.new(1, 2, 3)
		local b = Vector3.new(11, 8, -7)
		local startP = M.point(a, b, 0)
		local endP = M.point(a, b, 1)
		t.expect((startP - a).Magnitude).toBeCloseTo(0, 1e-9)
		t.expect((endP - b).Magnitude).toBeCloseTo(0, 1e-9)
		local mid = M.point(a, b, 0.5)
		t.expect(mid.Y).toBeCloseTo((a.Y + b.Y) * 0.5 + M.ARC, 1e-6)
		t.expect(M.point(a, b, 0.5, 0).Y).toBeCloseTo((a.Y + b.Y) * 0.5, 1e-6)
	end)

	t.test("the lens interpolates, narrows at the middle, then settles", function()
		t.expect(M.fov(75, 70, 0)).toBeCloseTo(75, 1e-9)
		t.expect(M.fov(75, 70, 1)).toBeCloseTo(70, 1e-9)
		local mid = M.fov(75, 70, 0.5)
		t.expect(mid).toBeCloseTo(72.5 - M.FOV_DIP, 1e-6)
		t.expect(mid < 70).toBeTruthy()
	end)

	t.test("the effects pulse peaks at the middle and is zero at both ends", function()
		t.expect(M.pulse(0)).toBeCloseTo(0, 1e-9)
		t.expect(M.pulse(0.5)).toBeCloseTo(1, 1e-9)
		t.expect(M.pulse(1)).toBeCloseTo(0, 1e-9)
	end)

	t.test("the body is hidden at the eye and visible clear of it", function()
		t.expect(M.bodyAlpha(0.2)).toBeCloseTo(1, 1e-9)
		t.expect(M.bodyAlpha(M.FADE_NEAR)).toBeCloseTo(1, 1e-9)
		t.expect(M.bodyAlpha(M.FADE_FAR)).toBeCloseTo(0, 1e-9)
		t.expect(M.bodyAlpha(20)).toBeCloseTo(0, 1e-9)
		local mid = M.bodyAlpha((M.FADE_NEAR + M.FADE_FAR) * 0.5)
		t.expect(mid).toBeCloseTo(0.5, 1e-6)
	end)

	t.test("the reduced-motion cut is black only at its midpoint", function()
		t.expect(M.cutAlpha(0)).toBeCloseTo(0, 1e-9)
		t.expect(M.cutAlpha(0.5)).toBeCloseTo(1, 1e-9)
		t.expect(M.cutAlpha(1)).toBeCloseTo(0, 1e-9)
		t.expect(M.cutAlpha(0.25)).toBeCloseTo(M.cutAlpha(0.75), 1e-9)
	end)

	t.test("pullIn leaves a clear point alone and stops short of a hit", function()
		local eye = Vector3.zero
		local p = Vector3.new(0, 0, -10)
		t.expect((M.pullIn(eye, p, nil, 0.5) - p).Magnitude).toBeCloseTo(0, 1e-9)
		t.expect((M.pullIn(eye, p, 20, 0.5) - p).Magnitude).toBeCloseTo(0, 1e-9)
		local pulled = M.pullIn(eye, p, 4, 0.5)
		t.expect(pulled.Z).toBeCloseTo(-3.5, 1e-6)
		t.expect(M.pullIn(eye, p, 0, 0.5).Magnitude).toBeCloseTo(0, 1e-9)
	end)

	t.test("aboveWater lifts a dipped camera and leaves a clear one alone", function()
		local p = Vector3.new(2, 1, 3)
		local lifted = M.aboveWater(p, 4, 1.5)
		t.expect(lifted.Y).toBeCloseTo(5.5, 1e-9)
		t.expect(lifted.X).toBeCloseTo(2, 1e-9)
		t.expect(lifted.Z).toBeCloseTo(3, 1e-9)
		local clear = Vector3.new(2, 9, 3)
		t.expect((M.aboveWater(clear, 4, 1.5) - clear).Magnitude).toBeCloseTo(0, 1e-9)
	end)

	t.test("reduce motion shortens the move to the fade cut", function()
		t.expect(M.duration(true)).toBeCloseTo(M.CUT, 1e-9)
		t.expect(M.duration(false)).toBeCloseTo(M.DURATION, 1e-9)
		t.expect(M.CUT < M.DURATION).toBeTruthy()
	end)

	t.test("the close-work dolly ends looking at the care area", function()
		local eye = Vector3.new(0, 5, 0)
		local focus = Vector3.new(0, 2, -4)
		local want = (focus - eye).Unit
		local aim = M.aim(eye, focus)
		t.expect(aim.Position.Magnitude).toBeCloseTo(eye.Magnitude, 1e-9)
		t.expect(aim.LookVector:Dot(want)).toBeCloseTo(1, 1e-6)
	end)

	t.test("the care-area look point holds a comfortable 1.5 to 2.5 studs", function()
		local eye = Vector3.new(0, 5, 0)
		local far = M.aimPoint(eye, Vector3.new(0, 2, -4), 1.5, 2.5)
		t.expect((far - eye).Magnitude).toBeCloseTo(2.5, 1e-6)
		local near = M.aimPoint(eye, eye + Vector3.new(0, 0, -1), 1.5, 2.5)
		t.expect((near - eye).Magnitude).toBeCloseTo(1.5, 1e-6)
		local inRange = eye + Vector3.new(0, 0, -2)
		t.expect((M.aimPoint(eye, inRange, 1.5, 2.5) - inRange).Magnitude).toBeCloseTo(0, 1e-9)
		-- a focus under the eye has no direction: keep a level view, never a NaN
		local same = M.aim(eye, eye)
		t.expect((same.LookVector - Vector3.new(0, 0, -1)).Magnitude).toBeCloseTo(0, 1e-9)
	end)
end
